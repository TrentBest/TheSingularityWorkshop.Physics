{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrentBest/TheSingularityWorkshop.Physics/blob/development/docs/experiments/lesson-manifest.schema.json",
  "title": "Physics learning lesson manifest",
  "description": "Instructional metadata for a bounded physics lesson. This is a lesson-content contract, not a MicroBundleDomain runtime manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lessonId",
    "title",
    "question",
    "status",
    "model",
    "defaultExperiment",
    "learningObjectives",
    "assumptions",
    "limitations",
    "visualizations",
    "validation"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "lessonId": {
      "type": "string",
      "pattern": "^physics\\.lesson\\.[a-z0-9.-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "implemented-demo",
        "partial",
        "planned"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "runRecordSchemaVersion",
        "entryPoint"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "runRecordSchemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "entryPoint": {
          "type": "string"
        }
      }
    },
    "defaultExperiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialHeightMetres",
        "initialVelocityMetresPerSecond",
        "accelerationMetresPerSecondSquared",
        "deltaTimeSeconds",
        "stepCount"
      ],
      "properties": {
        "initialHeightMetres": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "initialVelocityMetresPerSecond": {
          "type": "number"
        },
        "accelerationMetresPerSecondSquared": {
          "type": "number",
          "exclusiveMaximum": 0
        },
        "deltaTimeSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stepCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "learningObjectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "visualizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "path",
          "source",
          "description"
        ],
        "properties": {
          "type": {
            "const": "svg"
          },
          "path": {
            "type": "string"
          },
          "source": {
            "enum": [
              "recorded-run",
              "illustration",
              "mixed"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "acceptance"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextLessons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedTheory": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
